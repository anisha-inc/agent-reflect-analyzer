#!/usr/bin/env bash
# Vendored GitHub App token minter, adapted for this public repo.
#
# Prints an installation token to stdout (TTL ~1h). Adapted from an internal
# upstream: GH_APP_OP_ITEM (the 1Password item path for the GitHub App) is
# REQUIRED here rather than defaulting to an internal vault item, so nothing
# environment-specific is baked into a public file.

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'USAGE'
github-app-token — print installation token to stdout (TTL ~1h).

Usage:
  ./github-app-token              # prints token to stdout
  ./github-app-token --help       # this message

Env required:
  ANISHA_OP_SVC_TOKEN             # 1Password service-account token
  GH_APP_OP_ITEM                  # 1Password item path for the GitHub App, e.g. "Vault/Item"

Env optional:
  GH_APP_INSTALLATION_ID          # bypass auto-discovery
  GH_APP_TARGET_ORG               # org login to scope the installation (default: anisha-inc)

NB: token is installation-scoped (org-level). Per-repo / per-permission scoping
is NOT supported by this variant. Permissions follow the GitHub App config.
USAGE
  exit 0
fi

set -euo pipefail

: "${ANISHA_OP_SVC_TOKEN:?ANISHA_OP_SVC_TOKEN must be set}"
: "${GH_APP_OP_ITEM:?GH_APP_OP_ITEM must be set (1Password item path for the GitHub App)}"
export OP_SERVICE_ACCOUNT_TOKEN="$ANISHA_OP_SVC_TOKEN"

# 1Password item fields: app_id (or APP_ID — op read is case-insensitive) and
# private_key (full multi-line PEM). installation_id is auto-discovered via
# /app/installations unless GH_APP_INSTALLATION_ID is set.

APP_ID=$(op read "op://${GH_APP_OP_ITEM}/app_id")

KEY_FILE=$(mktemp)
trap 'rm -f "$KEY_FILE"' EXIT
op read "op://${GH_APP_OP_ITEM}/private_key" > "$KEY_FILE"

now=$(date +%s)
iat=$((now - 60))
exp=$((now + 540))

# Portable base64: GNU has `-w0`, BSD/macOS doesn't. Strip newlines after the
# fact so the function works on both. Then URL-safe substitutions + drop pad.
b64url() { base64 | tr -d '\n' | tr '+/' '-_' | tr -d '='; }

header_b64=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
payload_b64=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$iat" "$exp" "$APP_ID" | b64url)

signature=$(printf '%s.%s' "$header_b64" "$payload_b64" \
  | openssl dgst -sha256 -sign "$KEY_FILE" -binary \
  | b64url)

jwt="${header_b64}.${payload_b64}.${signature}"

gh_api() {
  curl -fsS \
    -H "Authorization: Bearer ${jwt}" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "$@"
}

if [ -n "${GH_APP_INSTALLATION_ID:-}" ]; then
  INSTALLATION_ID="$GH_APP_INSTALLATION_ID"
else
  installations=$(gh_api "https://api.github.com/app/installations")

  GH_APP_TARGET_ORG="${GH_APP_TARGET_ORG:-anisha-inc}"
  INSTALLATION_ID=$(printf '%s' "$installations" \
    | jq -r --arg org "$GH_APP_TARGET_ORG" \
        '.[] | select(.account.login==$org) | .id' \
    | head -n1)

  if [ -z "$INSTALLATION_ID" ] || [ "$INSTALLATION_ID" = "null" ]; then
    echo "github-app-token: could not discover installation_id" >&2
    echo "installations response: $installations" >&2
    exit 1
  fi
fi

response=$(gh_api -X POST \
  "https://api.github.com/app/installations/${INSTALLATION_ID}/access_tokens")

token=$(printf '%s' "$response" | jq -r '.token')

if [ -z "$token" ] || [ "$token" = "null" ]; then
  echo "github-app-token: failed to obtain installation token" >&2
  echo "response: $response" >&2
  exit 1
fi

printf '%s' "$token"
